{
  "name": "human-history",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dynamic evidence map of human history, driven by the Human History master prompt and evidence ledger.",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-data.ts",
    "export": "tsx scripts/export-data.ts",
    "audit": "tsx scripts/audit.ts",
    "check": "npm run validate && npm run audit && npm run coverage",
    "coverage": "tsx scripts/coverage-md.ts",
    "floor": "node scripts/measure-mobile.cjs",
    "export:ml": "tsx scripts/export-ml.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "world-atlas": "^2.0.2"
  }
}