{
  "name": "human-history",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dynamic evidence map of human history, driven by the Human History master prompt and evidence ledger.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-data.ts",
    "export": "tsx scripts/export-data.ts",
    "audit": "tsx scripts/audit.ts",
    "check": "npm run validate && npm run audit"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "world-atlas": "^2.0.2"
  }
}